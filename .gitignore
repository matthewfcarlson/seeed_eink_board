# PlatformIO build artifacts
.pio/

# User images (users provide their own)
*.jpg
*.jpeg
*.png
*.JPG
*.JPEG
*.PNG

# Node / Cloudflare Workers (worker/)
worker/node_modules/
worker/.wrangler/
worker/.dev.vars

# Compiled client-side JS (see worker/scripts/build-client.mjs)
worker/public/static/*.js
worker/public/static/*.js.map

# Generated at deploy time (see worker/scripts/record-dist-hashes.mjs) —
# the durable, auditable record is worker/dist-hashes.log, which IS tracked.
worker/public/static/build-info.json

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
